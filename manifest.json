{
    "manifest_version": 3,
    "name": "LiPaste",
    "version": "1.0",
    "description": "Load PGN into Lichess Analysis",
    "icons": {
      "48": "icons/icon.png"
    },
    "action": {
      "default_popup": "popup.html",
      "default_icon": "icons/icon.png"
    },
    "permissions": [
        "tabs",
        "webNavigation",
        "activeTab",
        "scripting"
    ],
    "content_scripts": [
        {
            "matches": ["https://lichess.org/paste"],
            "js": ["content.js"]
        }
    ]
  }
  